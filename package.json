{
  "name": "solex-ecommerce",
  "version": "1.0.0",
  "description": "SOLEX Premium Footwear & Sneaker E-Commerce Platform",
  "main": "server/index.js",
  "scripts": {
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"node server/index.js\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client run build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.0",
    "uuid": "^11.1.0"
  }
}
